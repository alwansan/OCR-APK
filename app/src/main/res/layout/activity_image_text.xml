<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:focusableInTouchMode="true" android:orientation="vertical"
    android:background="?attr/colorSurface">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/imageToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/image_text_title"
        app:navigationIcon="@android:drawable/ic_menu_revert"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:paddingHorizontal="12dp" android:orientation="horizontal">
        <TextView android:id="@+id/pageLabel" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurfaceVariant" android:textSize="13sp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/resetZoom" style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/fit_image"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/previousPage" style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/previous_page"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/nextPage" style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/next_page"/>
    </LinearLayout>

    <com.alwansan.crashlogocr.LiveTextImageView
        android:id="@+id/imageCanvas"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#111318"
        android:contentDescription="@string/image_select_help"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingHorizontal="12dp" android:paddingTop="8dp" android:orientation="vertical">
        <TextView android:id="@+id/selectionCount"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="?attr/colorPrimary" android:textSize="13sp"
            android:text="@string/select_words_hint"/>
        <TextView android:id="@+id/selectionText"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:minHeight="40dp"
            android:maxLines="2" android:ellipsize="end" android:textDirection="firstStrong"
            android:textIsSelectable="false"
            android:text="@string/select_words_hint"
            android:textColor="?attr/colorOnSurface" android:textSize="14sp"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingHorizontal="8dp" android:gravity="center_vertical" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/selectAllWords" style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/select_all_words"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/clearSelected" style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/clear_selection"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingBottom="12dp"
        android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/copySelected" android:layout_width="0dp"
            android:layout_weight="2" android:layout_height="54dp"
            app:cornerRadius="16dp" android:text="@string/copy_selected"
            android:enabled="false"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/shareSelected" style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="54dp" android:layout_marginStart="8dp"
            app:cornerRadius="16dp" android:text="@string/share_text"
            android:enabled="false"/>
    </LinearLayout>
</LinearLayout>
