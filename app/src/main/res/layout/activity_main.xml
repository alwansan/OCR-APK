<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="#F7F9FC">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="18dp"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CrashLogOCR"
            android:textColor="#152B50"
            android:textSize="30sp"
            android:textStyle="bold"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/subtitle"
            android:textColor="#64748B"
            android:textSize="14sp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/selectImage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/pick_image"
                android:textAllCaps="false"/>
            <Button
                android:id="@+id/pasteText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/paste_text"
                android:textAllCaps="false"/>
        </LinearLayout>
        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="8dp"
            android:text="@string/idle"
            android:textSize="13sp"
            android:textColor="#44536A"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/raw_label"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#152B50"/>
        <EditText
            android:id="@+id/rawText"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="6dp"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:gravity="top|start"
            android:textDirection="ltr"
            android:inputType="textMultiLine|textNoSuggestions"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:hint="@string/raw_hint"/>
        <Button
            android:id="@+id/cleanAgain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/clean_again"
            android:textAllCaps="false"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/clean_label"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#152B50"/>
        <EditText
            android:id="@+id/cleanText"
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:layout_marginTop="6dp"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:gravity="top|start"
            android:textDirection="ltr"
            android:inputType="textMultiLine|textNoSuggestions"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:hint="@string/clean_hint"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/copyClean"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/copy_text"
                android:textAllCaps="false"/>
            <Button
                android:id="@+id/shareClean"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/share_text"
                android:textAllCaps="false"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
